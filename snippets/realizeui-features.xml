<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
    Lunaris is used as the initial feature donor because its 16.2 branches
    already integrate the Axion SDK. RealizeUI owns Settings and vendor/lineage;
    donor customization frontends must not be added here.
  -->
  <remote name="lunaris"
          fetch="https://github.com/"
          revision="refs/heads/16.2"
          sync-c="true"
          sync-j="4" />

  <!-- Core feature contracts and SystemUI implementation. -->
  <remove-project path="device/lineage/sepolicy" />
  <remove-project path="frameworks/base" />
  <remove-project path="frameworks/libs/systemui" />
  <remove-project path="frameworks/native" />
  <remove-project path="lineage-sdk" />
  <remove-project path="system/sepolicy" />

  <project path="device/lineage/sepolicy" name="Lunaris-AOSP/device_lineage_sepolicy" remote="lunaris" />
  <project path="external/FadingEdgeLayout" name="Lunaris-AOSP/external_FadingEdgeLayout" remote="lunaris" />
  <project path="frameworks/base" name="Lunaris-AOSP/frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="lunaris" />
  <project path="frameworks/libs/systemui" name="Lunaris-AOSP/frameworks_libs_systemui" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="lunaris" />
  <project path="frameworks/native" name="Lunaris-AOSP/frameworks_native" groups="pdk" remote="lunaris" />
  <project path="lineage-sdk" name="Lunaris-AOSP/lineage-sdk" remote="lunaris" />
  <project path="axion-sdk" name="Lunaris-AOSP/axion-sdk" remote="lunaris" />
  <project path="system/sepolicy" name="Lunaris-AOSP/system_sepolicy" groups="pdk" remote="lunaris" />

  <!-- Standalone feature services and applications. -->
  <project path="packages/apps/AppLocker" name="Lunaris-AOSP/packages_apps_AppLocker" remote="lunaris" />
  <project path="packages/apps/AxThemeStore" name="Lunaris-AOSP/packages_apps_AxThemeStore" remote="lunaris" />
  <project path="packages/apps/ColumbusService" name="Lunaris-AOSP/packages_apps_ColumbusService" remote="lunaris" />
  <project path="packages/apps/FaceUnlock" name="Lunaris-AOSP/packages_apps_FaceUnlock" remote="lunaris" />
  <project path="packages/apps/GameSpace" name="Lunaris-AOSP/packages_apps_GameSpace" remote="lunaris" />
  <project path="packages/apps/LMOFreeform" name="Lunaris-AOSP/packages_apps_LMOFreeform" remote="lunaris" />
  <project path="packages/apps/OmniStyle" name="Lunaris-AOSP/packages_apps_OmniStyle" remote="lunaris" />
  <project path="packages/apps/Sandbox" name="Lunaris-AOSP/packages_apps_Sandbox" remote="lunaris" />
  <project path="packages/services/AxQuickLook" name="Lunaris-AOSP/packages_services_AxQuickLook" remote="lunaris" />
  <project path="packages/services/OmniJaws" name="Lunaris-AOSP/packages_services_OmniJaws" remote="lunaris" />
</manifest>
